<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Produtos</title>

    <link rel="stylesheet" href="/style.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4">
        Produtos da Fazenda Urbana
    </h1>

    <h4>
        Bem-vindo, <%= usuario %>
    </h4>

    <ul class="list-group mt-4" id="listaProdutos">

        <% produtos.forEach(produto => { %>

            <li 
                class="list-group-item d-flex justify-content-between align-items-center"
                data-id="<%= produto.id %>">

                <span class="nome-produto">
                    <%= produto.nome %>
                </span>

                <div>

                    <button
                        class="btn btn-warning btn-sm"
                        onclick="editarProduto(this)">

                        Editar

                    </button>

                    <button
                        class="btn btn-danger btn-sm"
                        onclick="deletarProduto(this)">

                        Excluir

                    </button>

                </div>

            </li>

        <% }) %>

    </ul>

    <button
        class="btn btn-success mt-4"
        onclick="pedirProdutos()">

        Pedir Produtos

    </button>

</div>


<script>

function editarProduto(botao) {

    const item = botao.closest('li');

    const span = item.querySelector('.nome-produto');

    const novoNome = prompt(
        'Editar produto:',
        span.innerText
    );

    if (novoNome) {

        span.innerText = novoNome;

    }

}

function deletarProduto(botao) {

    const item = botao.closest('li');

    item.remove();

}

async function pedirProdutos() {

    const produtos = [];

    document.querySelectorAll('.nome-produto')
        .forEach(produto => {

            produtos.push(produto.innerText);

        });

    const resposta = await fetch('/pedido', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify({
            produtos
        })

    });

    const dados = await resposta.json();

    alert(dados.mensagem);

    location.reload();

}

</script>

</body>
</html>