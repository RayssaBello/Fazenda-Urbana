<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Contato</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="/style.css">
</head>

<body>

<header class="header">
  <div class="header_menu">

    <div class="header_logo">
      <img src="/logo.png" alt="Logo">
    </div>

    <nav class="header_nav">
      <ul class="lista_nav"> 
        <li><a href="/">Início</a></li>
        <li><a href="/login">Login</a></li>
        <li><a href="/impactos">Impacto</a></li>
        <li><a href="/contato">Contato</a></li>
        <li><a href="/parceiros">Parceiros</a></li>
        <li><a href="/produtos">Produtos</a></li>
      </ul>
    </nav>

  </div>
</header>

<main class="contato">

  <section class="contato_container">

    <h1 class="titulo_gradiente">
      FALE COM A FAZENDA URBANA
    </h1>

    <p>
      Estamos prontos para ouvir suas ideias, parcerias e dúvidas.
      Preencha o formulário abaixo e nossa equipe entrará em contato com você em breve.
    </p>

    <form id="meu_contato">

      <input 
        type="text"
        id="nome"
        placeholder="Nome"
      >

      <input
        type="email"
        id="email"
        placeholder="E-mail"
      >

      <input
        type="text"
        id="numero"
        placeholder="Número de celular com DDD"
      >

      <button
        type="button"
        id="botao_formulario"
      >
        Enviar
      </button>

    </form>

    <p id="mensagem"></p>
    
    <p class="frase_destaque">
      Juntos podemos cultivar um futuro mais verde e sustentável!
    </p>

  </section>

</main>


<script src="/js/contato.js"></script>

</body>
</html>